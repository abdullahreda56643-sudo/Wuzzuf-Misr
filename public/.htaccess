RewriteEngine On

# Route unknown files and folders to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# Deny direct access to sensitive files
<FilesMatch "^(composer\.json|install\.sql|README\.md|\.env|\.htaccess)$">
    Require all denied
</FilesMatch>

# Default index file
DirectoryIndex index.php

# Prevent directory listing
Options -Indexes

